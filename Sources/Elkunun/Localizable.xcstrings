      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the campaign from level 1?"
          }
        }
      }
    },
    "¿Tienes un código?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a code?"
          }
        }
      }
    }
